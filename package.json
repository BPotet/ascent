{
  "name": "ascent",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@react-native/jest-preset": "^0.86.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "react-dom": "^19.2.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:bdd": "jest --selectProjects bdd",
    "test:coverage": "jest --coverage",
    "mutation": "stryker run",
    "mutation:domain": "stryker run stryker.domain.config.mjs",
    "mutation:changed": "node scripts/mutation-changed.mjs",
    "commitlint:range": "commitlint --from origin/develop --to HEAD --verbose",
    "secrets": "node scripts/gitleaks.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run arch && npm run test:coverage",
    "verify:full": "npm run verify && npm run mutation:domain && npm run mutation"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --fix"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  }
}
